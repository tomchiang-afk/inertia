<?xml version="1.0" encoding="utf-8"?>
<!-- Inertia home widget, medium (4x2). Texts are set from the snapshot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_paper">

    <ImageView
        android:id="@+id/accent_rule"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#9B1B2E"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="Inertia"
                android:textColor="#1A1A1A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#8A8A8A"
                android:textSize="9sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/widget_placeholder"
            android:textColor="#5C5C5C"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/left_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nw_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/nw_value"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:autoSizeMaxTextSize="23sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:id="@+id/pace_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pace_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_marginRight="4dp"
                            android:maxLines="1"
                            android:textColor="#5C5C5C"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/pace_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="#2F5D4A"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/goal_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/goal_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="9.5sp" />

                    <ImageView
                        android:id="@+id/goal_bar"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="#E8E8E8"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/buckets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/bucket_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bucket_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/bucket_value_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bucket_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bucket_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/bucket_value_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bucket_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bucket_label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/bucket_value_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bucket_row_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bucket_label_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="#5C5C5C"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/bucket_value_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="#1A1A1A"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/rhythm_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

    </LinearLayout>
</FrameLayout>
